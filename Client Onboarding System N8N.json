      "parameters": {
        "promptType": "define",
        "text": "=Generate a professional onboarding email using the following client information.\n\nClient Details\n\nFull Name:\n{{ $json[\"Full Name\"] }}\n\nEmail:\n{{ $json[\"Email Address\"] }}\n\nPhone:\n{{ $json[\"Phone Number\"] }}\n\nCompany:\n{{ $json[\"Company Name\"] }}\n\nProject Type:\n{{ $json[\"Project Type\"] }}\n\nProject Description:\n{{ $json[\"Project Description\"] }}\n\nRequirements:\n\n- Create a professional email subject.\n- Address the client by their first name.\n- Thank them for choosing TechNova Solutions.\n- Confirm that we have successfully received their project request.\n- Include a \"Project Summary\" section.\n- Include their project description.\n- Tell them our team will review the project and contact them within 24–48 business hours.\n- Thank them for trusting TechNova Solutions.\n- End with a professional closing.\n\nReturn ONLY JSON.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "=You are a Client Success Manager at TechNova Solutions.\n\nYour responsibility is to generate professional client onboarding emails.\n\nRules:\n- Be professional, friendly, and concise.\n- Address the client by their name {{ $json[\"Full Name\"] }}\n- Thank the client for choosing TechNova Solutions.\n- Confirm that their project inquiry has been successfully received.\n- Mention that our development team will review the requirements.\n- Inform the client that we will contact them within 24–48 business hours.\n- Use a warm and professional tone.\n- Do not use Markdown.\n- Return only valid JSON matching the provided schema. "
        }
      },
